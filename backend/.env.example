# Copy to .env and fill in. Used when running uvicorn from the backend/ directory.

# JWT for web login (POST /api/auth/login, /register). Required in production — use a long random string.
# JWT_SECRET=
# JWT_EXPIRE_MINUTES=10080

# SQLite user data (MVP): prediction history + wishlist/shortlist + app_user. Default: <repo>/data/propertylens.db — created automatically.
# DATABASE_URL=sqlite:////absolute/path/to/propertylens.db
# Production example: DATABASE_URL=postgresql+psycopg2://user:pass@host/dbname

# Default artefacts: <repo>/data/artifacts/ (hybrid_cluster_bundle.joblib, hybrid_xai/*)
# PROPERTYLENS_ARTIFACTS_DIR=/absolute/path/to/data/artifacts

# Feature table CSVs for hybrid address lookup + trend fallback (latest hdb_feature_table_*.csv)
# PROPERTYLENS_FEATURE_LAYER_OUTPUTS=/absolute/path/to/02_feature_layer/training/outputs

# Pin one hdb_feature_table_*.csv for parity with training notebooks (same rows / POI columns as the model was trained on).
# Absolute path, or path relative to repo root. If unset, the lexicographically latest CSV under outputs is used.
# PROPERTYLENS_FEATURE_TABLE_CSV=data/feature_data/02_feature_layer/training/outputs/hdb_feature_table_20260406.csv

# Keep data/artifacts/hybrid_cluster_bundle.joblib in sync with the notebook build you compare against; mismatched bundles will differ from notebook numbers even with CSV + sklearn aligned.

# xgboost 3.2.0 is required for correct predictions — the pickled XGB models produce wrong outputs under xgboost 2.x.
# scikit-learn 1.8 (matches bundle pickles) is only installable on Python 3.11+; use Python 3.11+ for the backend venv to avoid InconsistentVersionWarning on load.

# Chat (/api/chat) — default is local Ollama; set CHAT_PROVIDER=gemini to use Google only
# CHAT_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma3
# GEMINI_API_KEY=

# Neo4j (optional; policy KB and chat RAG fall back without it)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# Vector RAG (POST /api/rag-chat — Pinecone hybrid RAG; UI: Ask AI beta · VectorDB)
# PINECONE_API_KEY=
# PINECONE_INDEX=propertylens-rag
# BM25_CACHE_PATH=notebooks/05_chatbot/bm25_encoder_v3.pkl
# RAG_V51_ENABLED=1
# Preload Pinecone + encoders at startup so the first /api/rag-chat is not silent after HTTP 200 (set 0 to skip faster boot)
# RAG_V51_WARMUP=1
