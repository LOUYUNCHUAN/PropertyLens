# PropertyLens — environment variables template.
# Copy this file to `.env` and replace placeholder values.
# `.env` is gitignored; never commit it.

# ── Hugging Face ──────────────────────────────────────────────────
# Read-scoped token used by download_artifacts_from_hf.ipynb to pull
# the model bundle, XAI caches, and feature tables.
# Create at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# ── Neo4j (required for /api/property-search-chat and /api/chat) ─
# AuraDB Free works: https://neo4j.com/cloud/aura
# Local Neo4j Desktop default: bolt://localhost:7687, user "neo4j"
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_with_password
NEO4J_DATABASE=neo4j

# ── Chat provider ─────────────────────────────────────────────────
# ollama | gemini | auto  (auto tries Ollama first, falls back to Gemini)
CHAT_PROVIDER=ollama

# Ollama (only used when CHAT_PROVIDER includes ollama)
# Run: ollama serve  &&  ollama pull gemma3
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3

# Gemini fallback (optional). Leave empty to disable.
GEMINI_API_KEY=

# ── Auth (JWT) ────────────────────────────────────────────────────
# Any random string is fine for local dev. Change for production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# ── Persistence ───────────────────────────────────────────────────
# Defaults to sqlite:///data/propertylens.db (created on first run).
# Override only if you want to point elsewhere (e.g. Postgres in prod).
# DATABASE_URL=sqlite:///data/propertylens.db

# ── Path overrides (rare) ─────────────────────────────────────────
# Pin a specific feature-table CSV instead of using the latest snapshot.
# PROPERTYLENS_FEATURE_TABLE_CSV=data/feature_data/02_feature_layer/training/outputs/hdb_feature_table_20260412.csv

# Override artifact / feature-data roots if you keep them outside the repo.
# PROPERTYLENS_ARTIFACTS_DIR=/abs/path/to/artifacts
# PROPERTYLENS_FEATURE_LAYER_OUTPUTS=/abs/path/to/feature_data/.../outputs

# ── Frontend (consumed by Vite at build/dev time) ─────────────────
# Usually unset — frontend hits same-origin /api/*.
# VITE_API_BASE_URL=http://localhost:8000
# VITE_OLLAMA_MODEL=gemma3
